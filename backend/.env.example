# Copy to .env (never commit the filled file)

# TiDB Cloud (MySQL-compatible). Example:
# DATABASE_URL=jdbc:mysql://gateway01.<region>.prod.aws.tidbcloud.com:4000/budgetbuddy?sslMode=VERIFY_IDENTITY
DATABASE_URL=jdbc:h2:mem:budgetbuddy;MODE=MySQL;DB_CLOSE_DELAY=-1;DATABASE_TO_LOWER=TRUE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# JWT signing secret - generate with: openssl rand -base64 48
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef0123456789abcdef

# Google OAuth client ID (same value as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# OpenAI - stays server-side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Comma-separated allowed origins for CORS (frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Reporting timezone for monthly aggregation
APP_TIMEZONE=Asia/Kolkata
